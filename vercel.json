{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/signup",
      "destination": "/?start=open-account",
      "permanent": false
    },
    {
      "source": "/signup-pending",
      "destination": "/?start=application-status",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/account-services",
      "schedule": "0 13 * * *"
    }
  ]
}
